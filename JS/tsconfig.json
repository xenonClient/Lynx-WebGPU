{
  // The shim ships as plain .js. TypeScript is used **only as a checker and a .d.ts generator** —
  // there is no build output, so the bundle pipeline (rspeedy) eats webgpu.js as it always has.
  //
  //   npm run typecheck  — type checking against the JSDoc (what runs in CI and the hooks)
  //   npm run types      — regenerates webgpu.d.ts from the JSDoc
  //
  // webgpu.d.ts is not in include. Inside the program it would (1) shadow webgpu.js with a declaration of
  // the same name, making the check meaningless, and (2) fail declaration emit for overwriting its own input.
  //
  // `// @ts-check` is not put in webgpu.js — checking is turned on by checkJs here.
  // Baked into the file, it would force checking on for whoever copies it (Projects/WebGPUDemo/DemoSrc/src)
  // too, and there is no lynx-env.d.ts there, so the build breaks.
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // DOM is left out — accidentally using a browser global would die on PrimJS.
    // What the host actually provides is written in lynx-env.d.ts alone.
    "lib": ["ES2021"],

    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    // `npm run types` overwrites webgpu.d.ts with this configuration.
    // No outDir is set — the declaration comes out next to the source (webgpu.d.ts), and
    // specifying an outDir makes tsc auto-exclude that directory, leaving include empty.
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": ["webgpu.js", "lynx-env.d.ts"]
}
